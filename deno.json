{
  "tasks": {
    "dev": "LOGOSELL_DEV=1 deno run --allow-net --allow-read --allow-env server/main.ts",
    "test": "deno test --no-prompt --allow-read=.well-known,server,s.html,. server/",
    "golden": "deno run --no-prompt --allow-read=server --allow-write=server/golden server/golden_update.ts",
    "wellknown": "deno run --no-prompt --allow-read=.well-known,server --allow-write=server/wellknown.ts server/wellknown_update.ts"
  },
  "fmt": { "lineWidth": 100, "singleQuote": true, "exclude": ["server/golden/"] },
  "imports": {
    "jsr:@std/http@1/file-server": "jsr:@std/http@1.0.23/file-server"
  },
  "deploy": {
    "org": "x1ray-f",
    "app": "logosell-web"
  }
}

